# STEP 1: Import Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

# ------------------------------------------------------------
# STEP 1: LOAD CSV
# ------------------------------------------------------------

# તમારી CSV file નું નામ અહીં આપો
file_path = "face_dataset.csv"

df = pd.read_csv(file_path)

print("\n========== DATA LOADED ==========")
print(df.head())

print("\nDataset Shape:")
print(df.shape)

print("\nColumn Names:")
print(df.columns.tolist())


# ============================================================
# STEP 2: DATA CLEANING
# ============================================================

print("\n========== DATA CLEANING ==========")

# Duplicate rows
print("Duplicate rows:", df.duplicated().sum())

df = df.drop_duplicates()

# Column names clean
df.columns = df.columns.str.strip()

# String columns clean
for col in df.select_dtypes(include="object").columns:
    df[col] = df[col].astype(str).str.strip()

# Convert confidence score to numeric
df["confidence_score"] = pd.to_numeric(
    df["confidence_score"],
    errors="coerce"
)

# Convert year to numeric
df["year"] = pd.to_numeric(
    df["year"],
    errors="coerce"
)

# Convert date
df["date_collected"] = pd.to_datetime(
    df["date_collected"],
    errors="coerce",
    dayfirst=True
)

print("\nData Types:")
print(df.dtypes)


# ============================================================
# STEP 3: MISSING VALUES CHECK
# ============================================================

print("\n========== MISSING VALUES ==========")

missing = df.isnull().sum()

print(missing)

print("\nMissing Percentage:")
print((df.isnull().sum() / len(df) * 100).round(2))

# Remove rows where target label is missing
df = df.dropna(subset=["label"])

# Fill numerical missing values
if df["confidence_score"].isnull().any():
    df["confidence_score"] = df["confidence_score"].fillna(
        df["confidence_score"].median()
    )

if df["year"].isnull().any():
    df["year"] = df["year"].fillna(
        df["year"].median()
    )

# Fill categorical missing values
categorical_columns = [
    "category",
    "gender",
    "age_group",
    "source",
    "fake_method",
    "image_quality",
    "resolution",
    "detection_difficulty"
]

for col in categorical_columns:
    if col in df.columns:
        df[col] = df[col].fillna("Unknown")

print("\nMissing values after cleaning:")
print(df.isnull().sum())


# ============================================================
# STEP 4: REAL vs FAKE DISTRIBUTION
# ============================================================

print("\n========== REAL vs FAKE ==========")

print(df["label"].value_counts())

print("\nPercentage:")
print(
    df["label"]
    .value_counts(normalize=True)
    .mul(100)
    .round(2)
)

plt.figure(figsize=(7, 5))

sns.countplot(
    data=df,
    x="label"
)

plt.title("REAL vs FAKE Image Distribution")
plt.xlabel("Image Label")
plt.ylabel("Number of Images")
plt.tight_layout()
plt.show()


# ============================================================
# STEP 5: GENDER, AGE, QUALITY ANALYSIS
# ============================================================

# ---------- Gender ----------
plt.figure(figsize=(7, 5))

sns.countplot(
    data=df,
    x="gender",
    hue="label"
)

plt.title("REAL vs FAKE Images by Gender")
plt.xlabel("Gender")
plt.ylabel("Number of Images")
plt.tight_layout()
plt.show()


# ---------- Age Group ----------
plt.figure(figsize=(8, 5))

sns.countplot(
    data=df,
    x="age_group",
    hue="label"
)

plt.title("REAL vs FAKE Images by Age Group")
plt.xlabel("Age Group")
plt.ylabel("Number of Images")
plt.xticks(rotation=30)
plt.tight_layout()
plt.show()


# ---------- Image Quality ----------
plt.figure(figsize=(7, 5))

sns.countplot(
    data=df,
    x="image_quality",
    hue="label"
)

plt.title("REAL vs FAKE Images by Image Quality")
plt.xlabel("Image Quality")
plt.ylabel("Number of Images")
plt.tight_layout()
plt.show()


# ---------- Detection Difficulty ----------
plt.figure(figsize=(8, 5))

sns.countplot(
    data=df,
    x="detection_difficulty",
    hue="label"
)

plt.title("REAL vs FAKE by Detection Difficulty")
plt.xlabel("Detection Difficulty")
plt.ylabel("Number of Images")
plt.xticks(rotation=30)
plt.tight_layout()
plt.show()


# ---------- Fake Method ----------
if "fake_method" in df.columns:

    plt.figure(figsize=(10, 5))

    sns.countplot(
        data=df,
        x="fake_method",
        hue="label"
    )

    plt.title("Fake Method Distribution")
    plt.xlabel("Fake Method")
    plt.ylabel("Number of Images")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()


# ============================================================
# STEP 6: GRAPHS / VISUALIZATION
# ============================================================

# Confidence Score Distribution
plt.figure(figsize=(8, 5))

sns.histplot(
    data=df,
    x="confidence_score",
    hue="label",
    kde=True,
    bins=20
)

plt.title("Confidence Score Distribution")
plt.xlabel("Confidence Score")
plt.ylabel("Frequency")
plt.tight_layout()
plt.show()


# Confidence Score by Label
plt.figure(figsize=(7, 5))

sns.boxplot(
    data=df,
    x="label",
    y="confidence_score"
)

plt.title("Confidence Score by REAL / FAKE")
plt.xlabel("Label")
plt.ylabel("Confidence Score")
plt.tight_layout()
plt.show()


# Dataset Split
plt.figure(figsize=(7, 5))

sns.countplot(
    data=df,
    x="dataset_split",
    hue="label"
)

plt.title("Dataset Split Distribution")
plt.xlabel("Dataset Split")
plt.ylabel("Number of Images")
plt.tight_layout()
plt.show()


# Correlation of numerical columns
numeric_cols = [
    "label_numeric",
    "confidence_score",
    "year"
]

available_numeric = [
    col for col in numeric_cols
    if col in df.columns
]

if len(available_numeric) > 1:

    plt.figure(figsize=(8, 6))

    sns.heatmap(
        df[available_numeric].corr(),
        annot=True,
        cmap="coolwarm"
    )

    plt.title("Numerical Feature Correlation")
    plt.tight_layout()
    plt.show()


# ============================================================
# STEP 7: CATEGORICAL → NUMERICAL
# ============================================================

print("\n========== FEATURE PREPARATION ==========")

# Target
y = df["label"].map({
    "REAL": 1,
    "FAKE": 0
})

# Features
features = [
    "category",
    "gender",
    "age_group",
    "source",
    "fake_method",
    "image_quality",
    "resolution",
    "confidence_score",
    "detection_difficulty",
    "year"
]

# Only use columns that exist
features = [
    col for col in features
    if col in df.columns
]

X = df[features].copy()

print("Features used:")
print(features)

# Categorical columns
categorical_features = X.select_dtypes(
    include=["object"]
).columns.tolist()

# Numerical columns
numerical_features = X.select_dtypes(
    include=["int64", "float64"]
).columns.tolist()

print("\nCategorical Features:")
print(categorical_features)

print("\nNumerical Features:")
print(numerical_features)


# ============================================================
# STEP 8: ML CLASSIFICATION MODEL
# ============================================================

# Preprocessing
preprocessor = ColumnTransformer(
    transformers=[
        (
            "categorical",
            OneHotEncoder(
                handle_unknown="ignore"
            ),
            categorical_features
        ),
        (
            "numerical",
            StandardScaler(),
            numerical_features
        )
    ]
)


# Random Forest Model
model = RandomForestClassifier(
    n_estimators=200,
    random_state=42,
    class_weight="balanced"
)


# Complete pipeline
pipeline = Pipeline(
    steps=[
        ("preprocessor", preprocessor),
        ("model", model)
    ]
)


# Train/Test split
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("\nTraining samples:", len(X_train))
print("Testing samples:", len(X_test))


# Train model
print("\nTraining model...")

pipeline.fit(
    X_train,
    y_train
)

print("Model training completed!")


# ============================================================
# STEP 9: ACCURACY, PRECISION, RECALL, F1
# ============================================================

y_pred = pipeline.predict(X_test)

accuracy = accuracy_score(
    y_test,
    y_pred
)

precision = precision_score(
    y_test,
    y_pred,
    zero_division=0
)

recall = recall_score(
    y_test,
    y_pred,
    zero_division=0
)

f1 = f1_score(
    y_test,
    y_pred,
    zero_division=0
)

print("\n========== MODEL PERFORMANCE ==========")

print(f"Accuracy  : {accuracy:.4f}")
print(f"Precision : {precision:.4f}")
print(f"Recall    : {recall:.4f}")
print(f"F1-Score  : {f1:.4f}")


print("\nPercentage:")
print(f"Accuracy  : {accuracy * 100:.2f}%")
print(f"Precision : {precision * 100:.2f}%")
print(f"Recall    : {recall * 100:.2f}%")
print(f"F1-Score  : {f1 * 100:.2f}%")


# Detailed classification report
print("\n========== CLASSIFICATION REPORT ==========")

print(
    classification_report(
        y_test,
        y_pred,
        target_names=["FAKE", "REAL"],
        zero_division=0
    )
)


# ============================================================
# STEP 10: CONFUSION MATRIX
# ============================================================

cm = confusion_matrix(
    y_test,
    y_pred
)

print("\n========== CONFUSION MATRIX ==========")
print(cm)


plt.figure(figsize=(7, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=["FAKE", "REAL"],
    yticklabels=["FAKE", "REAL"]
)

plt.title("Confusion Matrix")
plt.xlabel("Predicted Label")
plt.ylabel("Actual Label")
plt.tight_layout()
plt.show()


# ============================================================
# STEP 11: NEW DATA → REAL / FAKE PREDICTION
# ============================================================

def predict_image_data(
    category,
    gender,
    age_group,
    source,
    fake_method,
    image_quality,
    resolution,
    confidence_score,
    detection_difficulty,
    year
):

    new_data = pd.DataFrame([{
        "category": category,
        "gender": gender,
        "age_group": age_group,
        "source": source,
        "fake_method": fake_method,
        "image_quality": image_quality,
        "resolution": resolution,
        "confidence_score": confidence_score,
        "detection_difficulty": detection_difficulty,
        "year": year
    }])

    # Keep only training features
    new_data = new_data[features]

    prediction = pipeline.predict(
        new_data
    )[0]

    probability = pipeline.predict_proba(
        new_data
    )[0]

    if prediction == 1:
        result = "REAL"
        confidence = probability[1]
    else:
        result = "FAKE"
        confidence = probability[0]

    print("\n========== PREDICTION ==========")
    print("Prediction :", result)
    print(f"Confidence : {confidence * 100:.2f}%")

    return result, confidence


# ============================================================
# EXAMPLE NEW DATA
# ============================================================

predict_image_data(
    category="Authentic",
    gender="Female",
    age_group="18-25",
    source="Unsplash",
    fake_method="None",
    image_quality="High",
    resolution="1080x1080",
    confidence_score=0.96,
    detection_difficulty="Easy",
    year=2026
)
